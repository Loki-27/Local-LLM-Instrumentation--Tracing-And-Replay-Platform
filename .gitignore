# ── Build output ──────────────────────────────────────────────────────────────
build/
cmake-build-*/
*.o
*.a
*.so
*.dylib
*.dll
compile_commands.json      # generated by CMake, too machine-specific to commit

# ── Models (too large for git) ────────────────────────────────────────────────
models/*.gguf
models/*.bin
models/*.ggml
!models/.gitkeep            # keep the folder itself tracked

# ── Test output ───────────────────────────────────────────────────────────────
tests/hook_dump.txt         # generated by test_hook_dump — commit yours for reference

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
*.xcodeproj/

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.clangd/
.cache/

# ── Python (if you add any tooling scripts later) ─────────────────────────────
__pycache__/
*.pyc
.venv/